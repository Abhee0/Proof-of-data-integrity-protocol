# ============================================================
# Proof of Data Integrity Protocol — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to source control.
# Add `.env` to your .gitignore.

# ----------------------------------------------------------
# Required
# ----------------------------------------------------------

# Alchemy or Infura HTTPS RPC endpoint for Sepolia testnet.
# Get one free at https://alchemy.com or https://infura.io
#
# Format: https://eth-sepolia.g.alchemy.com/v2/<YOUR_API_KEY>
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Deployed DataIntegrity contract address on the target network.
# Set this after running the Foundry deployment script.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Ethereum private key for the signing wallet.
#
# Security guidelines:
# - Use a dedicated wallet with only testnet ETH — never a hot wallet holding real funds.
# - On production systems, use a secrets manager (AWS Secrets Manager, Vault, etc.)
#   instead of a .env file.
# - The 0x prefix is optional.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_64_HEX_CHARS

# ----------------------------------------------------------
# Optional
# ----------------------------------------------------------

# Human-readable label for this wallet's uploads (stored in proof metadata).
UPLOADER_ALIAS=alice@example.com

# Override log level without using -v flags.
# Values: error, warn, info, debug, trace
# Module-specific: RUST_LOG=proof_of_data_integrity=debug,ethers=warn
# RUST_LOG=info
