;-1:-1:-1;3622:1352:29:o;4979:461::-;5166:6;5155:9;5148:25;5209:2;5204;5193:9;5189:18;5182:30;5248:6;5243:2;5232:9;5228:18;5221:34;5305:6;5297;5292:2;5281:9;5277:18;5264:48;5361:1;5332:22;;;5356:2;5328:31;;;5321:42;;;;5424:2;5403:15;;;-1:-1:-1;;5399:29:29;5384:45;5380:54;;4979:461;-1:-1:-1;;4979:461:29:o","linkReferences":{}},"methodIdentifiers":{"getProofRecord(bytes32)":"4840d123","getTimestamp(bytes32)":"d45c4435","storeProof(bytes32,string)":"6e84aefa","verifyProof(bytes32)":"b142b4ec"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"hash\",\"type\":\"bytes32\"}],\"name\":\"DuplicateProof\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"hash\",\"type\":\"bytes32\"}],\"name\":\"ProofNotFound\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"hash\",\"type\":\"bytes32\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"uploader\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"timestamp\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"string\",\"name\":\"filename\",\"type\":\"string\"}],\"name\":\"ProofStored\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"hash\",\"type\":\"bytes32\"}],\"name\":\"getProofRecord\",\"outputs\":[{\"components\":[{\"internalType\":\"uint256\",\"name\":\"timestamp\",\"type\":\"uint256\"},{\"internalType\":\"address\",\"name\":\"uploader\",\"type\":\"address\"},{\"internalType\":\"string\",\"name\":\"filename\",\"type\":\"string\"}],\"internalType\":\"struct DataIntegrity.ProofRecord\",\"name\":\"\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"hash\",\"type\":\"bytes32\"}],\"name\":\"getTimestamp\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"hash\",\"type\":\"bytes32\"},{\"internalType\":\"string\",\"name\":\"filename\",\"type\":\"string\"}],\"name\":\"storeProof\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"hash\",\"type\":\"bytes32\"}],\"name\":\"verifyProof\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"author\":\"Proof of Data Integrity Protocol\",\"errors\":{\"DuplicateProof(bytes32)\":[{\"details\":\"Returning the hash in the error lets the caller identify the collision      without a separate view call.\"}]},\"events\":{\"ProofStored(bytes32,address,uint256,string)\":{\"details\":\"`hash` and `uploader` are indexed to enable efficient off-chain filtering      (e.g., \\\"show me all proofs from address X\\\" or \\\"did this hash ever appear?\\\").\"}},\"kind\":\"dev\",\"methods\":{\"getProofRecord(bytes32)\":{\"details\":\"Returns a memory copy \\u2014 no storage pointer leak.\"},\"getTimestamp(bytes32)\":{\"details\":\"Reverts with ProofNotFound if hash is unknown, so callers can         distinguish \\\"not found\\\" from timestamp == 0 ambiguity.\"},\"storeProof(bytes32,string)\":{\"details\":\"No reentrancy risk: this function does not call external contracts,         does not transfer ETH, and state is written before the event emit.         The existence check on `timestamp != 0` is the duplicate guard.\",\"params\":{\"filename\":\"Optional human-readable label (e.g. \\\"report_q3_2024.pdf\\\").                  Stored as metadata only \\u2014 not part of the proof key.\",\"hash\":\"The raw bytes32 SHA-256 digest. Computed off-chain by the caller.\"}},\"verifyProof(bytes32)\":{\"details\":\"Pure boolean \\u2014 safe for any caller, no state mutation.\"}},\"stateVariables\":{\"_proofs\":{\"details\":\"Primary store. bytes32 key \\u2192 record.      Private: callers must use the getter functions; prevents silent misuse.\"}},\"title\":\"DataIntegrity\",\"version\":1},\"userdoc\":{\"errors\":{\"DuplicateProof(bytes32)\":[{\"notice\":\"Raised when attempting to store a hash that already exists.\"}],\"ProofNotFound(bytes32)\":[{\"notice\":\"Raised when querying a hash that has never been stored.\"}]},\"events\":{\"ProofStored(bytes32,address,uint256,string)\":{\"notice\":\"Emitted whenever a new proof is anchored on-chain.\"}},\"kind\":\"user\",\"methods\":{\"getProofRecord(bytes32)\":{\"notice\":\"Returns the full ProofRecord for a given hash.\"},\"getTimestamp(bytes32)\":{\"notice\":\"Returns the block timestamp at which the proof was stored.\"},\"storeProof(bytes32,string)\":{\"notice\":\"Anchors a SHA-256 hash on-chain as a timestamped proof-of-existence.\"},\"verifyProof(bytes32)\":{\"notice\":\"Returns true if the hash was previously stored, false otherwise.\"}},\"notice\":\"Stores SHA-256 hashes on-chain as immutable proof-of-existence records. Design decisions: - bytes32 for hashes: SHA-256 output is exactly 32 bytes; using bytes32 is   gas-efficient and avoids dynamic-length storage costs. - Custom errors (EIP-838): cheaper than require() + string, saves ~50 gas per revert. - No raw data stored: only the hash hits the chain, preserving privacy. - Mapping lookup is O(1) and avoids any enumerable pattern that could become   a DoS vector if abused with many entries. - `address uploader` recorded for auditability without coupling to access control.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/DataIntegrity.sol\":\"DataIntegrity\"},\"evmVersion\":\"shanghai\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"src/DataIntegrity.sol\":{\"keccak256\":\"0xa259219266455dede15d68a950c982c97b9bf4ef18f761f4a1ab6dca5fef5caa\",\"license\":\"