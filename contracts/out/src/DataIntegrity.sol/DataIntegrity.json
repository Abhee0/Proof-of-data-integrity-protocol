inter leak."},"getTimestamp(bytes32)":{"details":"Reverts with ProofNotFound if hash is unknown, so callers can         distinguish \"not found\" from timestamp == 0 ambiguity."},"storeProof(bytes32,string)":{"details":"No reentrancy risk: this function does not call external contracts,         does not transfer ETH, and state is written before the event emit.         The existence check on `timestamp != 0` is the duplicate guard.","params":{"filename":"Optional human-readable label (e.g. \"report_q3_2024.pdf\").                  Stored as metadata only — not part of the proof key.","hash":"The raw bytes32 SHA-256 digest. Computed off-chain by the caller."}},"verifyProof(bytes32)":{"details":"Pure boolean — safe for any caller, no state mutation."}},"version":1},"userdoc":{"kind":"user","methods":{"getProofRecord(bytes32)":{"notice":"Returns the full ProofRecord for a given hash."},"getTimestamp(bytes32)":{"notice":"Returns the block timestamp at which the proof was stored."},"storeProof(bytes32,string)":{"notice":"Anchors a SHA-256 hash on-chain as a timestamped proof-of-existence."},"verifyProof(bytes32)":{"notice":"Returns true if the hash was previously stored, false otherwise."}},"version":1}},"settings":{"remappings":["forge-std/=lib/forge-std/src/"],"optimizer":{"enabled":true,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"src/DataIntegrity.sol":"DataIntegrity"},"evmVersion":"shanghai","libraries":{}},"sources":{"src/DataIntegrity.sol":{"keccak256":"0xa259219266455dede15d68a950c982c97b9bf4ef18f761f4a1ab6dca5fef5caa","urls":["bzz-raw://f16e557200c9a3d85551369b040d3db117f34b1328bbfb800ae9e44725088dee","dweb:/ipfs/QmXSC7QJ7wC9XF53KJbKLvdFumjsGx8N6wJHbX1CBSaVPV"],"license":"MIT"}},"version":1},"id":23}